{
  "version": "rules-v2",
  "doc": "docs/decision_rules.md",
  "data": {
    "raw_dir": "data/raw/BBBC005_v1_images",
    "expected_files": 19200,
    "expected_shape_hw": [520, 696],
    "expected_dtype": "uint8"
  },
  "split": {
    "seed": 42,
    "samples": [1, 25],
    "n_train_samples": 15,
    "n_val_samples": 5,
    "n_test_samples": 5,
    "held_out_counts": [14, 40, 66, 91],
    "test_unseen_all_samples": true,
    "file": "splits/splits.csv",
    "hash_file": "splits/splits.sha256"
  },
  "stain": {
    "documented_nuclei_stain": 2,
    "count": 1,
    "blur": 1,
    "n_samples": 2,
    "min_containment": 0.90,
    "max_area_ratio": 0.70
  },
  "resolution": {
    "candidates_wh": [[128, 96], [256, 192], [348, 260]],
    "ablation_for": {"128x96": "256x192", "256x192": "128x96", "348x260": "256x192"},
    "resize": "PIL_BOX",
    "size_check": {"count": 1, "blur": 1, "n_samples": 5, "min_median_diameter_px": 3.0},
    "pair_check": {
      "count": 100,
      "blur": 1,
      "n_samples": 5,
      "peak_smoothing_sigma_rule": "d_native_div_4",
      "peak_window_rule": "odd_nearest_d_native_half_min3",
      "min_pair_distance_rule": "d_native_div_2",
      "line_points": 21,
      "max_saddle_to_peak": 0.80,
      "min_resolved_retention": 0.90
    }
  },
  "blur": {
    "scenes": "first_train_sample_x_seen_counts",
    "highpass_sigma_rule": "d_native_half_div_factor",
    "d_step": 0.20,
    "k_min": 4,
    "k_max": 6,
    "always_include": [1, 48]
  },
  "preprocess": {
    "target_scale": 100,
    "normalisation": "scalar_train_mean_std",
    "augmentation": {"hflip_p": 0.5, "vflip_p": 0.5},
    "pretrained_conv1": "sum_rgb",
    "prediction_postprocess": "none"
  },
  "baselines": {
    "mean": {"expected_train_mean": 50.05, "expected_test_seen_mae": 25.85},
    "brightness": {"feature": "mean_uint8_cached_image", "model": "ols_linear", "fit_on": "train"},
    "val_predictions": {"file": "results/baselines/val_predictions.csv", "made_by": "one_more_tracked_run_of_baselines_py"}
  },
  "evaluation": {
    "metrics": ["mae", "rmse", "r2"],
    "primary_set": "test_seen",
    "diagnostic_set": "test_unseen",
    "acceptance": {"ratio_best": 1.15, "ratio_mean": 0.60, "decide_on": "point_estimate"},
    "bootstrap": {"unit": "scene", "n": 10000, "seed": 42, "ci": 0.95, "method": "percentile", "paired_ratio": true}
  },
  "test_protocol": {
    "script": "scripts/evaluate_test.py",
    "final_models": ["mean", "brightness", "own_cnn", "standard_1", "standard_2"],
    "runs_per_model": 1,
    "force_requires_reason": true,
    "log": "results/test_log.csv",
    "ablations_on": "val",
    "aggregate_only_exception": "check_F_file_sanity",
    "cache_build_exception": "scripts/build_cache.py",
    "predictions_dir": "results/test_predictions",
    "beats_brightness": {
      "set": "test_seen",
      "statistic": "mae_cnn_over_mae_brightness",
      "paired": true,
      "wins_if_ci_high_below": 1.0,
      "energy_ratio": "gross_energy_per_1000_predictions_cpu"
    }
  },
  "models": {
    "own_cnn": {
      "channels": [16, 32, 64, 64],
      "kernel": 3,
      "pool": "avg_2x2_after_blocks_1_2_3",
      "head": "gap_linear",
      "norm": "batchnorm",
      "params": 60465,
      "macs_128x96": 37158976,
      "seeds": [42, 43, 44]
    },
    "standard_1": {
      "name": "resnet18",
      "weights": "IMAGENET1K_V1",
      "seeds": [42],
      "fine_tune": "all_layers"
    },
    "standard_2": {
      "name": "mobilenet_v3_small",
      "weights": "IMAGENET1K_V1",
      "seeds": [42, 43, 44],
      "fine_tune": "all_layers",
      "classifier_dropout": 0.0
    },
    "final_seed": 42,
    "conv1_input": "sum_rgb_to_1_channel",
    "failed_runs": "technical_crash_repeat_same_seed_bad_training_not_replaced"
  },
  "training": {
    "loss": "l1",
    "optimizer": "adamw",
    "weight_decay": 0.0001,
    "schedule": "cosine_to_zero",
    "warmup_steps": 0,
    "batch_size": 32,
    "drop_last": true,
    "max_steps": 3000,
    "output_bias_init": 0.5005,
    "amp_default": false,
    "cudnn_deterministic": true,
    "cudnn_benchmark": false,
    "data_on_gpu": true,
    "num_workers": 0,
    "early_stopping": {
      "metric": "val_mae_cells",
      "eval_every_steps": 150,
      "min_delta_cells": 0.02,
      "patience_evals": 6,
      "no_stop_before_step": 1500,
      "keep_best_checkpoint": true
    }
  },
  "lr_search": {
    "grid": [0.0001, 0.0003, 0.001, 0.003],
    "steps": 300,
    "seed": 42,
    "schedule": "cosine_over_trial",
    "choose": "lowest_val_mae_tie_lower_lr",
    "edge_values": {"below": 0.00003, "above": 0.01}
  },
  "ablations": {
    "on": "val",
    "seed": 42,
    "model": "own_cnn",
    "lr": "reuse_parent",
    "variants": {
      "resolution": "256x192",
      "depthwise_separable": {"blocks": [2, 3, 4], "params": 8449, "macs_128x96": 6475840}
    }
  },
  "efficiency_runs": {
    "amp": {"model": "standard_1", "seed": 42, "lr": "reuse_parent"},
    "amp_noise_reference": {"model": "standard_1", "seed": 42, "lr": "reuse_parent", "amp": false, "steps": 600, "compare": "energy_per_step"},
    "report_without_extra_runs": ["caching", "early_stopping"],
    "not_used": ["quantization", "pruning", "distillation"]
  },
  "measurement": {
    "macs_tool": "torch.utils.flop_counter.FlopCounterMode",
    "images": "val",
    "latency": {
      "batch_size": 1,
      "devices": ["gpu", "cpu"],
      "warmup_passes": 200,
      "timed_passes": 1000,
      "repeats": 5
    },
    "energy_per_1000": {
      "devices": {"cpu": "all_models", "gpu": "cnns"},
      "min_loop_s": 60,
      "repeats": 3,
      "idle_s": 60,
      "report": ["gross", "net"],
      "ratio_uses": "cpu_gross"
    }
  },
  "reporting": {
    "footprint": ["final_run_seed42", "seed42_plus_model_lr_trials", "project_total"],
    "training_energy": "absolute_values_no_ratio",
    "residuals_by_count": {"val": "every_model", "test": "final_models"},
    "max_planned_steps": 34200
  },
  "carbon": {
    "tracker": "OfflineEmissionsTracker",
    "country_iso_code": "TUR",
    "measure_power_secs": 5,
    "short_run_factor": 3,
    "index": "runs/index.csv",
    "categories": ["env", "preprocess", "analysis", "baseline", "search", "train", "eval", "measure"],
    "untracked_runs_note": "untracked, not measured"
  }
}
